{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "OPENAI_API_KEY", "DATABASE_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "typecheck": { "dependsOn": ["^build"] },
    "lint": {},
    "clean": { "cache": false }
  }
}
